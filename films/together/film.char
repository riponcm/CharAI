film "Together" 20s
stage width=2400 ground=600 scale=68
actor Tot = skin tot at 140
actor Baker = skin baker at 520 facing left
actor Skye = skin skye at 1040
actor Titan = skin titan at 1300 facing left
prop loaf at 600

# the bakery corner: a toddler runs to the baker for a hug and gets a loaf
0    cam: cut(to=700, zoom=1)
0    Tot: mood(happy)
0    Baker: mood(happy)
0    Skye: mood(angry, strength=0.6), armscrossed()
0    Titan: mood(angry, strength=0.6), handsonhips()
0.3  Tot: run(to=360)
+0   Tot: hug(with=Baker, speed=1.2)
0.6  cam: frame(on=Tot+Baker, over=1.2)
+0   Baker: give(with=Tot, prop=loaf)
+0   Tot: face(proud)

# next door: a scuffle, then friends again
11.7 cam: frame(on=Skye+Titan, over=0.8)
11.5 Skye: shove(with=Titan, speed=1.3)
+0   Titan: punchblock(with=Skye, speed=1.3)
+0   Skye: fistbump(with=Titan, speed=1.2)
+0   Skye: mood(happy)
+0   Titan: mood(happy), face(happy), wave()

# everyone in one picture
18.6 cam: home(over=0.8)
18.6 cam: pan(to=900, over=0.8)
18.5 Tot: wave()
18.6 Baker: wave()
