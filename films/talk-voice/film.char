film "Fresh Loaf (voiced)" 21s
stage width=1400 ground=600 scale=60
actor Baker = skin baker at 500
actor Skye = skin skye at 900 facing left

0    Baker: idle(), mood(proud), face(proud)
0    Skye: idle(), mood(tired, strength=0.4), face(tired)
0    cam: cut(to=700, zoom=1.7)

0.8  cam: frame(on=Baker, top=head, bottom=chest, x=0.4, over=0)
1.0  Baker: face(proud, strength=1.3)
1.1  Baker: say("Fresh from the oven, still warm!", for=3.28, track="lines/b1.json", beats=1)
1.1  caption: "Fresh from the oven, still warm!", by=Baker, for=3.3
1.3  Baker: reach(at=Skye, for=1.5)

4.6  cam: frame(on=Skye, top=head, bottom=chest, x=0.6, over=0)
4.6  Skye: face(tired)
4.8  Skye: say("It's bread.", for=1.6, track="lines/s1.json")
4.8  caption: "It's bread.", by=Skye, for=1.6
4.8  Skye: shrug(), look(at=front)

5.2  Baker: face(sad, strength=0.5)
6.5  Skye: face(surprised, strength=0.5), mood(neutral, strength=0)
6.8  Skye: say("Wait, is that cinnamon?", for=2.12, track="lines/s2.json")
6.8  caption: "Wait, is that cinnamon?", by=Skye, for=2.1

8.2  Baker: face(surprised, strength=0.6)
9.2  cam: frame(on=Baker, top=head, bottom=chest, x=0.4, over=0)
9.2  Baker: face(proud, strength=1.5)
9.4  Baker: say("Seven spices! My own secret!", for=4.13, track="lines/b2.json", beats=1)
9.4  caption: "Seven spices! My own secret!", by=Baker, for=4.1

13.6 cam: frame(on=Skye, top=head, bottom=chest, x=0.6, over=0)
13.6 Skye: look(at=front)
13.6 Skye: face(excited, strength=0.7), mood(happy)
13.9 Skye: say("Can I have a bite?", for=1.59, track="lines/s3.json", beats=1)
13.9 caption: "Can I have a bite?", by=Skye, for=1.6

14.1 Baker: face(happy, strength=1.2)
15.6 Skye: face(happy, strength=1.5), mood(happy)
15.9 Skye: say("Oh, that smells amazing!", for=2.24, track="lines/s4.json", beats=1)
15.9 caption: "Oh, that smells amazing!", by=Skye, for=2.2

18.5 cam: home(over=0)
18.5 cam: cut(to=700, zoom=1.7)
18.5 Baker: face(happy, strength=1.3)
18.7 Skye: cheer()
