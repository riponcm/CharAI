# moods.char - the same walk in four moods: mood() colours every move until the next mood line.
# Run it:  node tools/check.cjs examples/moods.char --timeline

film "Four moods" 14s
set hillside
actor Tess = skin tess at 300

# the camera follows her all the way
0.0  cam: follow(Tess, over=0.5)

# each section: mood, face and walk go on one line (different channels start together);
# the walk chains with +0
0.0  Tess: mood(happy), face(happy)
0.0  Tess: walk(to=540)
0.0  caption: "happy", for=2.8
+0   Tess: mood(sad), face(sad), walk(to=800)
3.3  caption: "sad", for=2.2

# strength= makes a mood stronger or weaker
+0   Tess: mood(angry, strength=1.2), face(angry), walk(to=1040)
5.9  caption: "angry", for=4

+0   Tess: mood(proud), face(proud), walk(to=1300)
10.3 caption: "proud", for=2.4
