# conversation.char - two people talk: say() speaks a line, caption "by=" draws the speech bubble.
# Run it:  node tools/check.cjs examples/conversation.char

film "Fresh loaf" 13s
stage width=1400 ground=600 scale=60
actor Baker = skin baker at 500
actor Skye = skin skye at 900 facing left

# a bare stage has no scenery; the camera frames both, close
0.0  cam: cut(to=700, zoom=1.3)
0.0  Baker: idle(), mood(proud), face(proud)
0.0  Skye: idle(), face(tired)

# line one: say() moves the mouth, caption shows the words (give both the same time)
0.8  Baker: say("Fresh from the oven, still warm!", for=2.2, beats=1)
0.8  caption: "Fresh from the oven, still warm!", by=Baker, for=2.2
1.0  Baker: reach(at=Skye, for=1.5)

# line two: Skye answers, shrugs and looks out at us
4.0  Skye: say("It's bread.", for=1.2)
4.0  caption: "It's bread.", by=Skye, for=1.4
4.0  Skye: shrug(), look(at=front)

# Baker's face falls; Skye looks back at him and sniffs the air
5.6  Baker: face(sad), look(at=Skye)
5.6  Skye: look(at=Baker), face(surprised, strength=0.5)

# line three: Skye changes her mind, Baker beams
6.4  Skye: say("Wait, is that cinnamon?", for=1.9)
6.4  caption: "Wait, is that cinnamon?", by=Skye, for=1.9
8.6  Baker: say("Seven spices!", for=1.4, beats=1), face(proud, strength=1.4)
8.6  caption: "Seven spices!", by=Baker, for=1.4
10.5 card: "Fresh bread"
